@model List<LeadMasterViewModel>


<div class="main-content">
    @* <div class="search-bar">
        <input type="text" placeholder="Search...">
        <button>Search</button>
    </div> *@

    <div class="p-6" style="margin-left: -23px;">
        <h2 class="text-xl font-semibold text-blue-600">Leads</h2>

        <!-- Filters Section -->
        <div class="mt-4 flex items-center space-x-3">
            <!-- All Leads -->
            <button class="flex items-center space-x-2 px-4 py-2 rounded-lg shadow bg-gray-200 text-black">
                <i data-lucide="filter" class="w-5 h-5"></i>
                <span>All Leads</span>
            </button>

            <!-- Contacted -->
            <button class="flex items-center space-x-2 px-4 py-2 rounded-lg shadow bg-gray-300 text-gray-600">
                <i data-lucide="phone" class="w-5 h-5"></i>
                <span>Contacted</span>
            </button>

            <!-- Not Contacted -->
            <button class="flex items-center space-x-2 px-4 py-2 rounded-lg shadow bg-gray-300 text-gray-600">
                <i data-lucide="phone-off" class="w-5 h-5"></i>
                <span>Not Contacted</span>
            </button>

            <!-- Qualified -->
            <button class="flex items-center space-x-2 px-4 py-2 rounded-lg shadow bg-gray-300 text-gray-600">
                <i data-lucide="check-circle" class="w-5 h-5"></i>
                <span>Qualified</span>
            </button>

            <!-- Add Filter -->
            <a href="#" class="text-blue-500 hover:underline">+ Add Filter</a>
        </div>

        <!-- Add Lead Button -->
        <div class="mt-4">
            <button class="bg-blue-600 text-white px-6 py-2 rounded-lg shadow" data-bs-toggle="modal" data-bs-target="#leadFormModal">+ ADD LEAD</button>
        </div>
    </div>

    <script>
        lucide.createIcons();
    </script>



    <div class="table-container">
        @if (Model != null && Model.Any())
        {
            <table>
                <thead>
                    <tr>
                        <th>No.</th>
                        <th>Date</th>
                        <th>Client Name</th>
                        <th>Enquiry For Site</th>
                        <th>Floor</th>
                        <th>Lead Source</th>
                        <th>Assigned To</th>
                        <th>Status</th>
                        <th>Lead Category</th>
                        <th>Phone</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.LeadId</td>
                            <td>@item.FirstName</td>
                            <td>@item.LastName</td>
                            <td>@item.ContactNo1</td>
                            <td>@item.Email</td>
                            <td>@item.AssignedToName</td>
                            <td>@item.SiteName</td>
                            <td><span class="status cold">Cold</span></td>
                            <td><span class="status hot">Hot</span></td>
                            <td><a asp-controller="Dashboard" asp-action="LeadDetails" asp-route-id="@item.LeadId" class="view-link">View Details</a></td>
                        </tr>
                    }

                   
                </tbody>
            </table>
        }
        else
        {
            <td>Records Not Found</td>
        }

    </div>
</div>


<!-- Modal -->
<div class="modal fade" id="leadFormModal" tabindex="-1" aria-labelledby="leadFormModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="leadFormModalLabel">Add New Lead</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form asp-action="AddLead" method="post">
                    <div class="row">
                        <div class="col-md-4">
                            <label class="form-label">First Name</label>
                            <input name="FirstName" type="text" class="form-control" placeholder="Enter first name">
                            <span onabort="FirstName" class="text-danger"></span>
                        </div>

                        <div class="col-md-4">
                            <label class="form-label">Last Name</label>
                            <input name="LastName" type="text" class="form-control" placeholder="Enter last name">
                            <span onabort="LastName" class="text-danger"></span>
                        </div>

                        @* <div class="col-md-4">
                            <label class="form-label">Select Site Name</label>
                            <select id="FkSiteId" name="FkSiteId" class="form-select">
                                <option value="">Select property type</option>
                            </select>
                        </div> *@

                        <div class="col-md-4">
                            <label class="form-label">Select Site Name</label>
                            <select name="FkSiteId" class="form-select" required>
                                <option value="">Select Role</option>
                                @if (ViewBag.SiteList != null)
                                {
                                    foreach (var site in ViewBag.SiteList)
                                    {
                                        <option value="@site.Id">@site.Name</option>
                                    }
                                }
                            </select>
                        </div>

                        @* <div class="col-md-4">
                            <label class="form-label">Property Type</label>
                            <select id="PropertyTypeId" name="PropertyTypeId" class="form-select">
                                <option>Select Property Type</option>
                            </select>
                        </div> *@

                        <div class="col-md-4">
                            <label class="form-label">Property Type</label>
                            <select name="FkPropertyTypeId" class="form-select" required>
                                <option value="">Select Role</option>
                                @foreach (var property in ViewBag.PropertyTypeList)
                                {
                                    <option value="@property.Id">@property.PropertyName</option>
                                }
                            </select>
                        </div>

                        @* <select id="PropertyTypeId" name="PropertyTypeId" class="form-select">
                            <option value="">Select Property Type</option>
                        </select> *@

                    </div>

                    <div class="row mt-3">
                        <div class="col-md-4">
                            <label class="form-label">Select Date</label>
                            <input name="ContactDate" type="date" class="form-control">
                        </div>

                       @*  <div class="col-md-4">
                            <label class="form-label">Source By</label>
                            <select id="SourcList" name="SourcList" class="form-select">
                                <option>Select Source</option>
                            </select>
                        </div> *@

                        <div class="col-md-4">
                            <label class="form-label">Source By</label>
                            <select name="FkSourceId" class="form-select" required>
                                <option value="">Select Source</option>
                                @foreach (var source in ViewBag.SourceList)
                                {
                                    <option value="@source.Id">@source.SourceName</option>
                                }
                            </select>
                        </div>

                        @* <select name="SourcList" class="form-select">
                            <option value="">Select Source</option>
                        </select> *@

                       @*  <div class="col-md-4">
                            <label class="form-label">Channel Partner</label>
                            <select id="ChannelPartnerList" name="ChannelPartnerList" class="form-select">
                                <option>Select Partner</option>
                            </select>
                        </div> *@

                        <div class="col-md-4">
                            <label class="form-label">Channel Partner</label>
                            <select name="FkChannelPartnerId" class="form-select" required>
                                <option value="">Channel Partner</option>
                                @foreach (var channel in ViewBag.ChannelPartnerList)
                                {
                                    <option value="@channel.Id">@channel.ChannnelName</option>
                                }
                            </select>
                        </div>

                        @* <select name="ChannelPartnerList" class="form-select">
                            <option value="">Select Partner</option>
                        </select> *@
                    </div>

                    <div class="row mt-3">
                        <div class="col-md-4">
                            <label class="form-label">Budget Range</label>
                            <div class="d-flex">
                                <input name="BudgetRangeFrom" type="text" class="form-control me-2" placeholder="From">
                                <input name="BudgetRangeTo" type="text" class="form-control" placeholder="To">
                                <span onabort="BudgetRangeFrom" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Contact Number 1</label>
                            <input name="ContactNo1" type="text" class="form-control" placeholder="Enter number">
                            <span onabort="ContactNo1" class="text-danger"></span>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Contact Number 2</label>
                            <input name="ContactNo2" type="text" class="form-control" placeholder="Enter number">
                            <span onabort="ContactNo2" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row mt-3">
                        <div class="col-md-4">
                            <label class="form-label">Address</label>
                            <input name="Address" type="text" class="form-control" placeholder="Enter Address">
                            <span onabort="Address" class="text-danger"></span>
                        </div>

                        <div class="col-md-4">
                            <label class="form-label">Email Id</label>
                            <input name="Email" type="email" class="form-control" placeholder="Enter email id">
                            <span onabort="Email" class="text-danger"></span>
                        </div>

                        @* <div class="col-md-4">
                            <label class="form-label">AssignTo User</label>
                            <select id="AssignUserList" name="AssignUserList" class="form-select">
                                <option>Select Status</option>
                            </select>
                        </div> *@

                        <div class="col-md-4">
                            <label class="form-label">AssignTo User</label>
                            <select name="FkUserIdAssigned" class="form-select" required>
                                <option value="">AssignTo User</option>
                                @foreach (var user in ViewBag.AssignUser)
                                {
                                    <option value="@user.Id">@user.UserName</option>
                                }
                            </select>
                        </div>

                       @*  <select name="AssignUserList" class="form-select">
                            <option value="">Select user</option>
                        </select> *@

                        <div class="col-md-4">
                            <label class="form-label">Status</label>
                            <select name="LeadStatus" class="form-select">
                                <option>Select Status</option>
                                <option value="0">Pending</option>
                                <option value="1">Completed</option>
                            </select>
                        </div>
                    </div>

                    <div class="row mt-3">
                        <div class="col-md-4">
                            <label  class="form-label">Lead Category</label>
                            <select name="LeadCategory" class="form-select">
                                <option>Select Category</option>
                                <option value="1">Warm</option>
                                <option value="2">Cold</option>
                                <option value="3">Hot</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Floor Preference</label>
                            <textarea name="FloorPreference" class="form-control" placeholder="Add floor preference"></textarea>
                            <span onabort="FloorPreference" class="text-danger"></span>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Notes</label>
                            <textarea name="Note" class="form-control" placeholder="Add new Notes"></textarea>
                            <span onabort="Note" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="modal-footer mt-4">
                        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary">Save</button>
                    </div>

                </form>
            </div>
        </div>
    </div>
</div>



<script src="~/assets/vendors/perfect-scrollbar/perfect-scrollbar.min.js"></script>
<script src="~/assets/js/bootstrap.bundle.min.js"></script>

<script src="~/assets/vendors/apexcharts/apexcharts.js"></script>
<script src="~/assets/js/pages/dashboard.js"></script>

<script src="~/assets/js/main.js"></script>



<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

